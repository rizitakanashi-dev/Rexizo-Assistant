# Rexizo — contoh konfigurasi lokal. Salin ke `.env` dan sesuaikan.
# File `.env` tidak boleh masuk ke git.

# --- Server ---
REXIZO_HOST=127.0.0.1
REXIZO_PORT=8000
# API key opsional. Kosongkan untuk mengizinkan akses dari localhost saja.
REXIZO_API_KEY=
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_API_KEY=

# --- Storage ---
REXIZO_DATABASE_URL=sqlite+aiosqlite:///./storage/jarvis.db
REXIZO_STORAGE_DIR=./storage
JARVIS_DATABASE_URL=sqlite+aiosqlite:///./storage/jarvis.db
JARVIS_STORAGE_DIR=./storage

# --- LLM Provider (OpenRouter / OpenAI-compatible) ---
# Masukkan API Key OpenRouter Anda (contoh: sk-or-v1-xxxxxx...)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=minimax/minimax-01

# Kompatibilitas alias backend
DATTIO_API_KEY=
DATTIO_BASE_URL=https://openrouter.ai/api/v1
DATTIO_MODEL=minimax/minimax-01
DATTIO_TOOL_MODE=auto
DATTIO_TEMPERATURE=0.2
REXIZO_TEST_MODE=false
JARVIS_TEST_MODE=false

# --- Guardrail AI Core ---
# AI_ENABLED=false mematikan seluruh fitur chat AI.
AI_ENABLED=true
# Tool mutating/destructive TIDAK pernah dikirim ke LLM kecuali dimatikan di sini.
AI_TOOLS_ENABLED=true
AI_MUTATING_TOOLS_ENABLED=false
# Tool-first: auto (hanya pertanyaan faktual), always, never.
AI_TOOL_FIRST=auto
AI_MAX_MESSAGE_CHARS=2000
AI_CHAT_DEADLINE_SECONDS=60

# --- Surveillance ---
# false = gunakan kamera fisik (/dev/video0) bila terdeteksi, true = feed sintetis.
REXIZO_MOCK_CAMERA_FEED=false
JARVIS_MOCK_CAMERA_FEED=false
REXIZO_MOTION_AREA_THRESHOLD_PERCENT=1.0
JARVIS_MOTION_AREA_THRESHOLD_PERCENT=1.0
REXIZO_EVENT_DEBOUNCE_SECONDS=10.0
JARVIS_EVENT_DEBOUNCE_SECONDS=10.0
JARVIS_OBJECT_DETECTION_MODEL_PATH=
JARVIS_OBJECT_DETECTION_LABELS_PATH=
JARVIS_OBJECT_DETECTION_CONFIDENCE=0.5
